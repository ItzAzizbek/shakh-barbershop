# Copy this file to .env and fill in your real values. Never commit .env.
PORT=3000

# Create a bot with https://t.me/BotFather, it will give you this token
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Chat that should receive booking notifications.
# For a personal chat: message your bot once, then open
#   https://api.telegram.org/bot<TOKEN>/getUpdates
# and copy the "chat":{"id": ...} value (can be negative for groups).
TELEGRAM_CHAT_ID=123456789
